function IncreaseLimits()
{
    Info "Increasing system limits (inotify, file handles)..."
    # fs.inotify.max_user_instances: limits the number of inotify instances that can be created.
    # DefaultLimitNOFILE: limits the number of open file descriptors per process for systemd services.
    sudo sysctl -w fs.inotify.max_user_instances=8192 &>/dev/null # -w writes to current sysctl
    # For persistence, these should be added to /etc/sysctl.conf (for inotify)
    # and /etc/systemd/system.conf / user.conf (for DefaultLimitNOFILE).
    # The sed commands modify systemd configs directly, which is correct.
    sudo sed -i 's/^.*DefaultLimitNOFILE=.*$/DefaultLimitNOFILE=65536/g' /etc/systemd/system.conf
    sudo sed -i 's/^.*DefaultLimitNOFILE=.*$/DefaultLimitNOFILE=65536/g' /etc/systemd/user.conf

    Success "Increased Limits"
}

