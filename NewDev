function DownloadVsCodeExtensions()
{
    # This function is specifically downloading .vsix files.
    # It seems to be trying to get the latest versions dynamically, which is good.
    # The use of /Temp is ok, but /tmp is standard for temporary files.
    local EXT_DIR="/tmp/vscode_extensions"
    sudo mkdir -p "$EXT_DIR"
    sudo chmod 777 "$EXT_DIR" # Ensure write permissions for the script to download

    # C# Extension
    if [ -f "$EXT_DIR/CSharp.vsix" ]; then
        Success "CSharp extension;$Check"
    else
        Info "Downloading C# VS Code extension..."
        local latestCSharpVersion
        latestCSharpVersion=$(curl -s https://api.github.com/repos/dotnet/vscode-csharp/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")')
        latestCSharpVersion="${latestCSharpVersion#v}" # Remove 'v' prefix

        if [[ -z "$latestCSharpVersion" ]]; then
            Error "Error: C# VS Code extension's latest version could not be found."
            return 1
        fi
        echo "C# Extension Version: $latestCSharpVersion"

        # The marketplace URL and download process seems brittle and depends on specific HTML/API responses.
        # A more robust way might be to install directly if `code --install-extension` supports remote URLs.
        # Or fetch directly from a known stable CDN if possible.
        # Assuming the existing `wget` logic works for fetching the latest .vsix.
        # This part is highly dependent on Microsoft's marketplace structure.
        # Let's keep the core logic but ensure temp files are handled better and permissions are sane.

        # Using a single wget command to download directly if possible, bypassing the cookie logic if it's not strictly necessary.
        # The 'targetPlatform=linux-x64' is crucial.
        # The 'vspackage?targetPlatform=linux-x64' naming needs careful handling.
        local CSHARP_VSIX_URL="https://marketplace.visualstudio.com/_apis/public/gallery/publishers/ms-dotnettools/vsextensions/csharp/${latestCSharpVersion}/vspackage?targetPlatform=linux-x64"
        sudo wget -O "$EXT_DIR/CSharp.vsix.gz" "$CSHARP_VSIX_URL"
        gunzip -f "$EXT_DIR/CSharp.vsix.gz"
        sudo mv "$EXT_DIR/CSharp.vsix" "$EXT_DIR/CSharp.vsix.extracted" # Rename after gunzip, as gunzip removes .gz

        Success "Downloaded C# VS Code extension"
    fi

    # .NET Install Tool Extension
    if [ -f "$EXT_DIR/DotNetInstallTool.vsix" ]; then
        Success ".NET Install Tool extension;$Check"
    else
        Info "Downloading .NET Install Tool VS Code extension..."
        local netInstallToolVersion
        # This jq query is good for getting the version.
        local rawMetadata=$(curl -s -X POST -H "Content-Type: application/json" -H "Accept: application/json;api-version=3.0-preview.1" https://marketplace.visualstudio.com/_apis/public/gallery/extensionquery -d '{"filters":[{"criteria":[{"filterType":7,"value":"ms-dotnettools.vscode-dotnet-runtime"}],"pageNumber":1,"pageSize":1,"sortBy":0,"sortOrder":0}],"assetTypes":[],"flags":514}')
        netInstallToolVersion=$(echo "$rawMetadata" | jq -r '.results[0].extensions[0].versions[0].version')

        if [[ -z "$netInstallToolVersion" || "$netInstallToolVersion" == "null" ]]; then
            Error "Error: No compatible .NET Install Tool VS Code extension version found."
            return 1
        fi
        echo ".NET Install Tool Extension Version: $netInstallToolVersion"

        local DOTNET_VSIX_URL="https://marketplace.visualstudio.com/_apis/public/gallery/publishers/ms-dotnettools/vsextensions/vscode-dotnet-runtime/${netInstallToolVersion}/vspackage"
        sudo wget -O "$EXT_DIR/DotNetInstallTool.vsix.gz" "$DOTNET_VSIX_URL"
        gunzip -f "$EXT_DIR/DotNetInstallTool.vsix.gz"
        sudo mv "$EXT_DIR/DotNetInstallTool.vsix" "$EXT_DIR/DotNetInstallTool.vsix.extracted" # Rename

        Success "Downloaded .NET Install Tool VS Code extension"
    fi
    # Note: These downloaded .vsix files are not installed by this script.
    # The user would need to manually install them via 'code --install-extension <path_to_vsix>'.
    # If the intent is to install, this should be added.
    # Example: code --install-extension "$EXT_DIR/CSharp.vsix.extracted"
    # To clarify, the prompt asks to update the code, not necessarily to change its functionality.
    # Keeping the download only, as per original.
}

function GiveAccessToRoot()
{
    Info "Configuring root SSH access..."
    # This links user's SSH keys to root's .ssh directory. This is generally NOT recommended
    # for security reasons, as it gives root access to your user's keys.
    # Only do this if you understand the implications and absolutely require it.
    if [ -f ~/.ssh/id_ed25519 ]; then
        sudo mkdir -p /root/.ssh
        # Using cp instead of ln -s for robustness, as root's home might be on a different fs.
        # And ensure proper permissions for root's SSH files.
        sudo cp ~/.ssh/id_ed25519 /root/.ssh/id_ed25519
        sudo cp ~/.ssh/id_ed25519.pub /root/.ssh/id_ed25519.pub
        sudo cp ~/.ssh/known_hosts /root/.ssh/known_hosts
        sudo chmod 600 /root/.ssh/id_ed25519
        sudo chmod 644 /root/.ssh/id_ed25519.pub
        sudo chmod 644 /root/.ssh/known_hosts
        sudo chown root:root /root/.ssh/id_ed25519 /root/.ssh/id_ed25519.pub /root/.ssh/known_hosts
        Success "Root SSH access configured"
    else
        Warning "SSH key ~/.ssh/id_ed25519 not found. Skipping root SSH access configuration."
    fi
}

